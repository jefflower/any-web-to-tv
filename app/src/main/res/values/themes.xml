<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnyWebToTv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.AnyWebToTv.Fullscreen" parent="Theme.AnyWebToTv">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.AnyWebToTv.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
